    <!-- Lot L3 (actors): ratings and loyalty moved to the core, profile ids aligned on the core, vetting status
         moved to delivery-core. Each file prints its diagnostic counts with RAISE NOTICE.
         Order matters: the ratings (302) are converted while the Go ids of evaluations.evaluator_id /
         evaluated_id (foreign keys to the legacy persons table, not repointable) still match the Go rows. -->

    <changeSet id="gdd-l3-302-evaluations-to-tp-ratings" author="gdd-l3" labels="gdd-l3">
        <comment>Go evaluations copied to tnt_tp_ratings with actor ids (id kept, duplicates counted).</comment>
        <sqlFile path="db/changelog/20261125_gdd_l3_302_evaluations_to_tp_ratings.sql"
                 relativeToChangelogFile="false" splitStatements="false"/>
    </changeSet>

    <changeSet id="gdd-l3-303-loyalty-accounts-from-orders" author="gdd-l3" labels="gdd-l3">
        <comment>tp-core loyalty accounts created or completed from Go order counts (total_orders * 10, H3).</comment>
        <sqlFile path="db/changelog/20261125_gdd_l3_303_loyalty_accounts_from_orders.sql"
                 relativeToChangelogFile="false" splitStatements="false"/>
    </changeSet>

    <changeSet id="gdd-l3-304-rating-averages-from-tp-ratings" author="gdd-l3" labels="gdd-l3">
        <comment>Profile averages (actor-core ActorRating, relay point rating) recomputed from tnt_tp_ratings.</comment>
        <sqlFile path="db/changelog/20261126_gdd_l3_304_rating_averages_from_tp_ratings.sql"
                 relativeToChangelogFile="false" splitStatements="false"/>
    </changeSet>

