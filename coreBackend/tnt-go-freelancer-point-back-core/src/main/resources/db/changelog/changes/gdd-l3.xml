        <comment>gofp_users.id realigned on core_user_id (actor id); foreign keys on gofp_users(id) repointed.</comment>
        <sqlFile path="db/changelog/20261125_gdd_l3_310_gofp_users_id_realign.sql"
                 relativeToChangelogFile="false" splitStatements="false"/>
    </changeSet>

