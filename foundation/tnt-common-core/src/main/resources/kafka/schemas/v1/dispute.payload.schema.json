{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tnt:kafka:v1:dispute.payload",
  "title": "Payload of tnt.dispute.events (spec §3.6), full dispute state after the event, masked (§3.4: no description, no comment, no evidence content)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "disputeId", "reference", "parcelId", "deliveryId", "incidentId", "cause", "status", "claimantType", "claimantId",
    "respondentType", "mediatorId", "resolutionType", "responsibleParty", "compensationAmount", "currency",
    "compensationPaymentRef", "evidenceCount", "deadline", "openedAt", "resolvedAt", "closedAt"
  ],
  "properties": {
    "disputeId": {"type": "string", "format": "uuid"},
    "reference": {"type": "string"},
    "parcelId": {"type": ["string", "null"], "format": "uuid"},
    "deliveryId": {"type": ["string", "null"], "format": "uuid"},
    "incidentId": {"type": ["string", "null"], "format": "uuid"},
    "cause": {"enum": ["PACKAGE_LOST", "PACKAGE_DAMAGED", "DELIVERY_DELAYED", "WRONG_CONTENT", "NON_DELIVERY", "FRAUD",
      "HUB_INCIDENT", "NETWORK_INCIDENT", "PAYMENT_DISPUTE", "OTHER"]},
    "category": {"type": ["string", "null"]},
    "priority": {"type": ["string", "null"]},
    "status": {"enum": ["OPEN", "UNDER_INVESTIGATION", "AWAITING_EVIDENCE", "MEDIATION_IN_PROGRESS",
      "PENDING_ARBITRATION", "PENDING_COMPENSATION", "COMPENSATED", "CLOSED_RESOLVED", "CLOSED_WITHDRAWN",
      "CLOSED_EXPIRED"]},
    "claimantType": {"enum": ["CLIENT", "RECIPIENT", "FREELANCER", "PERMANENT_DELIVERER", "HUB_OPERATOR",
      "AGENCY_MANAGER", "SYSTEM"]},
    "claimantId": {"type": ["string", "null"], "format": "uuid"},
    "respondentType": {"type": ["string", "null"]},
    "mediatorId": {"type": ["string", "null"], "format": "uuid"},
    "resolutionType": {"enum": ["COMPENSATION_GRANTED", "PARTIAL_COMPENSATION", "TOTAL_LOSS_COMPENSATED",
      "DAMAGE_COMPENSATED", "COMPLAINT_DISMISSED", "MUTUAL_AGREEMENT", "REDELIVERY_ORDERED",
      "RETURN_TO_SENDER_ORDERED", null]},
    "responsibleParty": {"enum": ["SENDER", "RECIPIENT", "COURIER", "PLATFORM", "RELAY", "AGENCY", "NONE", null]},
    "compensationAmount": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "currency": {"type": ["string", "null"]},
    "compensationPaymentRef": {"type": ["string", "null"]},
    "evidenceCount": {"type": "integer", "minimum": 0},
    "deadline": {"type": ["string", "null"], "format": "date-time"},
    "openedAt": {"type": ["string", "null"], "format": "date-time"},
    "resolvedAt": {"type": ["string", "null"], "format": "date-time"},
    "closedAt": {"type": ["string", "null"], "format": "date-time"}
  },
  "not": {"anyOf": [{"required": ["description"]}, {"required": ["summary"]}, {"required": ["comments"]}]}
}
